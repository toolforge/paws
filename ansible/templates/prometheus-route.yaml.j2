apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: prometheus
spec:
  parentRefs:
    - name: paws-gateway
      namespace: istio-system
  hostnames:
{% if datacenter == 'codfw1dev' %}
    - prometheus-paws.codfw1dev.wmcloud.org
{% else %}
    - prometheus-paws.wmcloud.org
{% endif %}
  rules:
    - backendRefs:
        - name: prometheus-server
          port: 80
